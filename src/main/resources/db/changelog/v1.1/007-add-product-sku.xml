<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-5.0.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">

    <changeSet id="007-add-product-sku-column" author="youssef">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="product" columnName="sku"/>
            </not>
        </preConditions>

        <comment>
            Adds the column nullable on purpose. NOT NULL and the unique constraint are
            applied by 007-add-product-sku-not-null-unique, which must run only after
            007-populate-product-sku has backfilled every existing row.
        </comment>

        <addColumn tableName="product">
            <column name="sku" type="VARCHAR(64)">
                <constraints nullable="true"/>
            </column>
        </addColumn>

        <rollback>
            <dropColumn tableName="product" columnName="sku"/>
        </rollback>
    </changeSet>

    <changeSet id="007-populate-product-sku" author="youssef">
        <comment>
            Deterministic backfill of the seed rows so they receive a stable business key
            for the batch import upsert. Keyed by primary key rather than title because
            titles are not unique.
        </comment>

        <update tableName="product">
            <column name="sku" value="SKU-0001"/>
            <where>id = 'b1000000-0000-0000-0000-000000000001'</where>
        </update>
        <update tableName="product">
            <column name="sku" value="SKU-0002"/>
            <where>id = 'b1000000-0000-0000-0000-000000000002'</where>
        </update>
        <update tableName="product">
            <column name="sku" value="SKU-0003"/>
            <where>id = 'b1000000-0000-0000-0000-000000000003'</where>
        </update>
        <update tableName="product">
            <column name="sku" value="SKU-0004"/>
            <where>id = 'b1000000-0000-0000-0000-000000000004'</where>
        </update>
        <update tableName="product">
            <column name="sku" value="SKU-0005"/>
            <where>id = 'b1000000-0000-0000-0000-000000000005'</where>
        </update>
        <update tableName="product">
            <column name="sku" value="SKU-0006"/>
            <where>id = 'b1000000-0000-0000-0000-000000000006'</where>
        </update>
        <update tableName="product">
            <column name="sku" value="SKU-0007"/>
            <where>id = 'b1000000-0000-0000-0000-000000000007'</where>
        </update>
        <update tableName="product">
            <column name="sku" value="SKU-0008"/>
            <where>id = 'b1000000-0000-0000-0000-000000000008'</where>
        </update>
        <update tableName="product">
            <column name="sku" value="SKU-0009"/>
            <where>id = 'b1000000-0000-0000-0000-000000000009'</where>
        </update>
        <update tableName="product">
            <column name="sku" value="SKU-0010"/>
            <where>id = 'b1000000-0000-0000-0000-000000000010'</where>
        </update>
        <update tableName="product">
            <column name="sku" value="SKU-0011"/>
            <where>id = 'b1000000-0000-0000-0000-000000000011'</where>
        </update>
        <update tableName="product">
            <column name="sku" value="SKU-0012"/>
            <where>id = 'b1000000-0000-0000-0000-000000000012'</where>
        </update>
        <update tableName="product">
            <column name="sku" value="SKU-0013"/>
            <where>id = 'b1000000-0000-0000-0000-000000000013'</where>
        </update>
        <update tableName="product">
            <column name="sku" value="SKU-0014"/>
            <where>id = 'b1000000-0000-0000-0000-000000000014'</where>
        </update>

        <rollback>
            <update tableName="product">
                <column name="sku" valueComputed="NULL"/>
                <where>created_by = 'system'</where>
            </update>
        </rollback>
    </changeSet>

    <changeSet id="007-add-product-sku-not-null-unique" author="youssef">
        <preConditions onFail="HALT">
            <sqlCheck expectedResult="0">SELECT COUNT(*) FROM product WHERE sku IS NULL</sqlCheck>
        </preConditions>

        <comment>
            Enforces the invariants only once every row carries a value. The backfill above
            targets the known seed primary keys, so on a database that has drifted from the
            seed data an unexpected row would leave this failing. HALT on purpose: a clear
            precondition failure beats an opaque ALTER TABLE ... SET NOT NULL error.
        </comment>

        <addNotNullConstraint columnName="sku" tableName="product" columnDataType="VARCHAR(64)"/>

        <addUniqueConstraint columnNames="sku" constraintName="uc_product_sku" tableName="product"/>

        <rollback>
            <dropUniqueConstraint tableName="product" constraintName="uc_product_sku"/>
            <dropNotNullConstraint tableName="product" columnName="sku" columnDataType="VARCHAR(64)"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
