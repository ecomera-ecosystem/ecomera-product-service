<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-5.0.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">

    <changeSet id="009-create-product-import-tables" author="youssef">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="product_import"/>
            </not>
        </preConditions>

        <comment>
            Creates product import tracking tables. These tables store import job metadata
            and per-row import results. Used by the batch import feature to track job
            execution history and provide detailed row-level error reporting.
        </comment>

        <createTable tableName="product_import">
            <column name="id" type="UUID">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_product_import"/>
            </column>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="updated_by" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="filename" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="file_checksum" type="VARCHAR(64)"/>
            <column name="initiated_by" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(32)">
                <constraints nullable="false"/>
            </column>
            <column name="total_rows" type="INT"/>
            <column name="created_count" type="INT"/>
            <column name="updated_count" type="INT"/>
            <column name="rejected_count" type="INT"/>
            <column name="error_message" type="TEXT"/>
            <column name="started_at" type="TIMESTAMP"/>
            <column name="completed_at" type="TIMESTAMP"/>
        </createTable>

        <createTable tableName="product_import_item">
            <column name="id" type="UUID">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_product_import_item"/>
            </column>
            <column name="import_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="line_number" type="INT"/>
            <column name="sku" type="VARCHAR(64)"/>
            <column name="title" type="VARCHAR(255)"/>
            <column name="description" type="TEXT"/>
            <column name="price" type="VARCHAR(50)"/>
            <column name="stock" type="INT"/>
            <column name="category_id" type="UUID"/>
            <column name="color" type="VARCHAR(50)"/>
            <column name="size" type="VARCHAR(20)"/>
            <column name="image_url" type="VARCHAR(255)"/>
            <column name="status" type="VARCHAR(32)"/>
            <column name="error_message" type="TEXT"/>
        </createTable>

        <addForeignKeyConstraint
            baseTableName="product_import_item"
            baseColumnNames="import_id"
            constraintName="fk_product_import_item_import"
            referencedColumnNames="id"
            referencedTableName="product_import"/>

        <addForeignKeyConstraint
            baseTableName="product_import_item"
            baseColumnNames="category_id"
            constraintName="fk_product_import_item_category"
            referencedColumnNames="id"
            referencedTableName="category"/>

        <rollback>
            <dropTable tableName="product_import_item"/>
            <dropTable tableName="product_import"/>
        </rollback>
    </changeSet>

</databaseChangeLog>